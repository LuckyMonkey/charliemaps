# CHOOSE A STRONG VALUE BEFORE STARTING, never commit actual credentials
NEO4J_PASSWORD=replace-with-long-random-password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
PORT=4100
# No key required for GTFS static download; optional for MBTA V3 API
MBTA_API_KEY=
MBTA_STATIC_URL=https://cdn.mbta.com/MBTA_GTFS.zip
MBTA_TRIP_UPDATES_URL=https://cdn.mbta.com/realtime/TripUpdates_enhanced.json
MBTA_VEHICLES_URL=https://cdn.mbta.com/realtime/VehiclePositions_enhanced.json
MBTA_ALERTS_URL=https://cdn.mbta.com/realtime/Alerts_enhanced.json
